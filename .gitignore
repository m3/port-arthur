# Dependency directories
node_modules/
jspm_packages/
web_modules/
bower_components/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
build/
dist/

# IDE and OS files
.DS_Store
.idea/
.vscode/
*.swp

# Python standard cache and environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/

# Local configuration secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# mex AST index — generated, rebuilt by `mex graph index`.
# The -wal/-shm sidecars are live SQLite journal state and change on every
# read, so tracking them produces permanent spurious diffs.
.mex/graph.db
.mex/graph.db-shm
.mex/graph.db-wal
